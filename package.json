{
  "name": "agent-qa-harness-template",
  "version": "0.1.0",
  "description": "Reusable multi-model agent QA harness scaffolding for web apps",
  "type": "module",
  "private": true,
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project chromium-desktop",
    "test:e2e:mobile": "playwright test --project mobile-iphone-13",
    "populate-auth": "tsx scripts/populate-auth.ts",
    "dispatch": "tsx scripts/multi-model-dispatch.ts",
    "dedup": "tsx scripts/dedup-findings.ts",
    "report": "tsx scripts/generate-report.ts",
    "scaffold": "bash scripts/scaffold.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
